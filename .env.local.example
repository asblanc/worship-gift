# Exemple de variables d'environnement — copiez dans .env.local
# (NE JAMAIS committer vos vraies clés)

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clé serveur — privilèges admin, contourne les RLS.
# À définir UNIQUEMENT côté serveur (Vercel > Environment Variables
# ou .env.local en dev). NE PAS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── WhatsApp ────────────────────────────────────────────────
# Format international sans + ni espaces (ex: 212600000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.worship-gift.com

# ── Google Analytics (GA4) — optionnel ──────────────────────
# ID de mesure depuis Google Analytics (commence par G-). Sans lui,
# le suivi est simplement désactivé.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Meta Pixel (Facebook / Instagram Ads) ───────────────────
# ID du pixel (Gestionnaire d'évènements > Ensembles de données).
# Sans cette variable, aucun script Meta n'est chargé.
NEXT_PUBLIC_META_PIXEL_ID=439132812615919

# Conversions API (fortement recommandé) — jeton d'accès généré dans
# Gestionnaire d'évènements > ton pixel > Paramètres > Conversions API
# > « Générer un token d'accès ». SERVEUR UNIQUEMENT (pas de NEXT_PUBLIC_).
# Sans lui, seul le pixel navigateur est actif (≈ 30-40 % de pertes).
META_CAPI_ACCESS_TOKEN=

# Facultatif — code de test (onglet « Tester les évènements ») pour
# vérifier les envois serveur. À RETIRER une fois la vérification faite,
# sinon les évènements ne comptent pas dans les vraies statistiques.
META_TEST_EVENT_CODE=

# Facultatif — version de l'API Graph utilisée par la Conversions API.
META_GRAPH_VERSION=v23.0

# Facultatif — code de vérification de domaine (Business Manager >
# Sécurité de la marque > Domaines > méta-balise). Nécessaire pour
# configurer les évènements agrégés (trafic iOS).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# ── Emails (Resend) — optionnel ─────────────────────────────
# Sans ces variables, les emails de confirmation sont simplement
# désactivés (le reste du site fonctionne normalement).
# Créer une clé sur https://resend.com puis vérifier ton domaine.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Worship Gift <billets@tondomaine.com>
# Destinataire des messages du formulaire de contact (défaut: contact@worship-gift.com)
CONTACT_EMAIL=contact@worship-gift.com

# ── Rate limiting distribué (Upstash Redis) — recommandé en prod ──
# Sans ces variables, le rate-limit se rabat sur la mémoire locale
# (par instance, non partagé). Pour un pic de charge / anti-abus fiable,
# crée une base Redis gratuite sur https://upstash.com et colle l'URL +
# le token REST. Le comptage devient alors partagé entre toutes les
# instances serverless.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Cron (rappels avant événement) ──────────────────────────
# Secret partagé : Vercel Cron l'envoie en header Authorization.
# Génère une valeur aléatoire (ex: openssl rand -hex 32).
CRON_SECRET=change-moi-pour-une-valeur-aleatoire

# ── Paiement CMI ────────────────────────────────────────────
# "test" = sandbox CMI, "prod" = production (REQUIERT les vraies clés
# ci-dessous, sinon l'init de paiement échoue volontairement).
PAYMENT_ENV=test
CMI_CLIENT_ID=your-cmi-client-id
CMI_STORE_KEY=your-cmi-store-key
CMI_GATEWAY_URL_TEST=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL_PROD=https://payment.cmi.co.ma/fim/est3Dgate
CMI_CALLBACK_URL=https://worship-gift.vercel.app/api/payment/cmi/callback
